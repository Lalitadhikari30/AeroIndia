# ──────────────────────────────────────────────────
# AeroIndia — Environment Variables
# ──────────────────────────────────────────────────
# Copy this file to .env and fill in the values.
# For production deployment, see DEPLOYMENT.md.

# ─── Spring Profile ─────────────────────────────
# "local" = Eureka service discovery (for local development)
# "prod"  = Direct URL routing (for Render deployment)
SPRING_PROFILES_ACTIVE=local

# ─── Database (Neon Postgres) ───────────────────
# Each service uses a separate database.
# For local dev, install PostgreSQL and create these databases:
#   ticketing_auth, ticketing_flight, ticketing_booking, ticketing_payment, ticketing_genai
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ticketing_auth?sslmode=disable
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# ─── JWT Secret ─────────────────────────────────
# MUST be the same value in auth-service AND api-gateway.
# Generate a 64-character hex string for production.
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970

# ─── Gmail SMTP (Notification Service) ──────────
# Generate a Google App Password at: https://myaccount.google.com/apppasswords
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Redpanda / Kafka (Event Streaming) ─────────
KAFKA_SERVERS=localhost:9092
KAFKA_USERNAME=admin
KAFKA_PASSWORD=your_kafka_password
ENABLE_KAFKA=false

# ─── Upstash Redis (Distributed Locking) ────────
ENABLE_REDIS=true
REDIS_ADDRESS=redis://localhost:6379
REDIS_PASSWORD=

# ─── Gemini API (GenAI Service) ─────────────────
# Get a free key at: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here

# ─── CORS (API Gateway only) ────────────────────
# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173

# ─── Direct Service URLs (prod profile only) ────
# Only needed when SPRING_PROFILES_ACTIVE=prod
# AUTH_SERVICE_URL=https://aeroindia-auth-service.onrender.com
# FLIGHT_SERVICE_URL=https://aeroindia-flight-service.onrender.com
# BOOKING_SERVICE_URL=https://aeroindia-booking-service.onrender.com
# PAYMENT_SERVICE_URL=https://aeroindia-payment-service.onrender.com
# NOTIFICATION_SERVICE_URL=https://aeroindia-notification-service.onrender.com
# GENAI_SERVICE_URL=https://aeroindia-genai-service.onrender.com
