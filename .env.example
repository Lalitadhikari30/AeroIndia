# ──────────────────────────────────────────────────
# AeroIndia - Environment Variables
# ──────────────────────────────────────────────────

# ─── Gmail SMTP (Notification Service) ───────────
# These are required for the notification-service to send real emails.
#
# GMAIL_USERNAME: Your full Gmail address (e.g. yourname@gmail.com)
# GMAIL_APP_PASSWORD: A Google App Password (NOT your regular Gmail password).
#
# To generate a Google App Password:
#   1. Go to https://myaccount.google.com/security
#   2. Enable 2-Step Verification (if not already enabled)
#   3. Go to https://myaccount.google.com/apppasswords
#   4. Select "Mail" as the app and your device type
#   5. Click "Generate" — you'll get a 16-character password (e.g. "abcd efgh ijkl mnop")
#   6. Paste the full 16-character password below (spaces included are fine)
#
# WARNING: Never commit real credentials. This file is a template only.
GMAIL_USERNAME=your-email@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# ─── Kafka (Optional — for event-driven notifications) ───
KAFKA_SERVERS=localhost:9092
KAFKA_USERNAME=admin
KAFKA_PASSWORD=password
ENABLE_KAFKA=false

# ─── Eureka Service Registry ────────────────────
EUREKA_URI=http://localhost:8761/eureka/
ENABLE_EUREKA=true

# ─── Database (Auth Service) ────────────────────
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ticketing_auth
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# ─── Gemini GenAI Assistant ─────────────────────
# GEMINI_API_KEY: Generated for free at https://aistudio.google.com (no credit card required)
GEMINI_API_KEY=your_gemini_api_key_here

